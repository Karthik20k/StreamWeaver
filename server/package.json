{
  "name": "streamweaver-server",
  "version": "0.1.0",
  "description": "High-throughput streaming backend for StreamWeaver",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test:memory": "node tests/verifyStreamingMemory.js 50",
